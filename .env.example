# 이 파일을 복사해 .env.local 을 만들고 값을 채운다. .env.local 은 저장소에 올라가지 않는다.
# 배포할 때는 같은 이름으로 Vercel 환경 변수에 직접 넣는다.
# VITE_ 로 시작하지 않는 값은 서버 함수(api/)에서만 읽는다. 브라우저 코드에 넣지 않는다.

# Claude API (사진·글 읽기, 내 말투, 메모 나누기) — 서버 전용
ANTHROPIC_API_KEY=
# 비워 두면 claude-opus-5-5 를 쓴다
ANTHROPIC_MODEL=

# 카카오 REST API 키 (장소 검색, 대중교통 경로) — 서버 전용
KAKAO_REST_API_KEY=

# Supabase (준비 현황 링크 공유, 푸시) — URL과 anon 키는 공개돼도 되는 값이다
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 서버 전용. 브라우저에 절대 넣지 않는다
SUPABASE_SERVICE_ROLE_KEY=
